APP_NAME=PinePet
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.pinepet.com.br
APP_TIMEZONE=America/Sao_Paulo

DB_DRIVER=pgsql
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=pinepet
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=8
DB_APPLICATION_NAME=pinepet-app

SESSION_NAME=pinepet_app
SESSION_SECURE=true
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
